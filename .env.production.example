# FIN-SYS OS — Variables de producción
# ⚠️ ESTE ARCHIVO NO VA A GIT — se configura en Dokploy Environment
# Este es solo un template de referencia (nombres verificados contra el código 2026-08-26)

# PostgreSQL (Supabase — pooler)
# ⚠️ Puerto 6543 = transaction mode (multiplexado, soporta muchos clientes).
#    Puerto 5432 del pooler = session mode, límite 15 clientes COMPARTIDO
#    entre producción y local → saturación (EMAXCONNSESSION) si ambos corren.
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_NAME=postgres
DB_USER=postgres.tu_proyecto_ref
DB_PASSWORD=tu_password_de_supabase
DB_PORT=6543

# Sesiones web (tokens HMAC de auth_guard; obligatoria en producción)
SESSION_SECRET=cadena_larga_aleatoria

# AI APIs
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Bot IA (Módulo 09) — token del bot de PRODUCCIÓN (el de dev vive en .env local)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Bot IA 09.F — purga de retención de borradores/mensajes (30/60/90 días). 0 = apagada.
# Los tokens del webhook de SMS NO van aquí: viven en la tabla sms_ingest_tokens.
BOT_RETENCION_ACTIVA=1

# CORS (dominio de producción)
CORS_ORIGINS=https://tu-dominio.com,http://localhost:5173
